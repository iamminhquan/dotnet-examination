@* =====================================================================
   [Câu 4 - Phần 2] Chi tiết BĐS phía Customer
   Mục đích: Hiển thị thông tin BĐS đang xem và danh sách "Các BĐS vừa xem"
             (Controller đã đọc từ Session và truyền sang qua PropertyDetailsViewModel).
   ===================================================================== *@
@model RealEstate.Models.ViewModels.PropertyDetailsViewModel

@{
    ViewData["Title"] = Model.Property.Title;
}

<div class="row g-4">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.Property.ImageUrl))
        {
            <img src="@Model.Property.ImageUrl" alt="@Model.Property.Title" class="img-fluid rounded shadow-sm" />
        }
    </div>
    <div class="col-md-6">
        <span class="badge bg-secondary mb-2">@Model.Property.Category?.Name</span>
        <h2>@Model.Property.Title</h2>
        <p class="fs-4 fw-bold text-danger">@Model.Property.Price.ToString("N0") ₫</p>
        <p style="white-space: pre-line;">@Model.Property.Description</p>
        <a asp-controller="Properties" asp-action="Index" class="btn btn-outline-secondary">&larr; Quay lại danh sách</a>
    </div>
</div>

@* [Câu 4 - Phần 2] Danh sách "Các BĐS vừa xem" lấy từ Session *@
@if (Model.RecentlyViewed.Any())
{
    <hr class="my-4" />
    <h4>Các BĐS vừa xem</h4>
    <div class="list-group">
        @foreach (var item in Model.RecentlyViewed)
        {
            <a asp-controller="Properties" asp-action="Details" asp-route-id="@item.Id"
               class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Title" class="rounded property-thumb" />
                }
                <div>
                    <div class="fw-semibold">@item.Title</div>
                    <small class="text-muted">@item.Category?.Name - @item.Price.ToString("N0") ₫</small>
                </div>
            </a>
        }
    </div>
}
