@* =====================================================================
   [Câu 4 - Phần 2] Danh sách BĐS phía Customer
   Mục đích: Hiển thị BĐS dạng thẻ (card); bấm "Xem chi tiết" để vào action Details
             (nơi ghi nhận Session "Các BĐS vừa xem").
   ===================================================================== *@
@model IEnumerable<Property>

@{
    var categoryName = ViewData["CategoryName"] as string;
    ViewData["Title"] = categoryName is null ? "Danh sách bất động sản" : $"Danh mục: {categoryName}";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có bất động sản nào.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top property-card-img" alt="@item.Title" />
                    }
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@item.Category?.Name</span>
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text fw-bold text-danger">@item.Price.ToString("N0") ₫</p>
                    </div>
                    <div class="card-footer bg-transparent border-0">
                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
