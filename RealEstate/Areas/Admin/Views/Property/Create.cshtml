@* =====================================================================
   [Câu 3 - Phần 3] View tạo mới BĐS (Admin)
   Mục đích: Form Bootstrap dùng Tag Helpers (asp-for, asp-validation-for, asp-items),
             có ô upload file ảnh và thẻ <select> danh mục.
   Bắt buộc enctype="multipart/form-data" để trình duyệt gửi được file lên server.
   ===================================================================== *@
@model Property

@{
    ViewData["Title"] = "Thêm bất động sản";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="row">
    <div class="col-lg-8">
        <form asp-area="Admin" asp-controller="Property" asp-action="Create" method="post" enctype="multipart/form-data">
            @* Hiển thị lỗi cấp model (không gắn với field cụ thể) *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            @* Tiêu đề *@
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="VD: Căn hộ 2PN view sông Sài Gòn" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            @* Giá *@
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" min="0.01" step="any" placeholder="VD: 2500000000" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            @* [Câu 3 - Phần 3] Thẻ <select> danh mục, dữ liệu lấy từ SelectList trong ViewBag.Categories *@
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories as SelectList" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            @* Mô tả *@
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            @* [Câu 3 - Phần 4] Ô upload file: name="imageFile" khớp tên tham số IFormFile imageFile trong action *@
            <div class="mb-3">
                <label for="imageFile" class="form-label">Hình ảnh (.jpg, .png - tối đa 2MB)</label>
                <input type="file" id="imageFile" name="imageFile" class="form-control" accept=".jpg,.png,image/jpeg,image/png" />
                @Html.ValidationMessage("imageFile", new { @class = "text-danger" })
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @* Kích hoạt validation phía client (jQuery Validation Unobtrusive) *@
    <partial name="_ValidationScriptsPartial" />
}
